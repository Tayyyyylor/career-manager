// Schéma de données de Career Manager.
// Documentation : https://pris.ly/d/prisma-schema
//
// Application multi-utilisateur : chaque donnée métier appartient à un User.
// Les modèles User / Session / Account / Verification sont ceux attendus par
// Better Auth (https://www.better-auth.com/docs/concepts/database).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentification (Better Auth) ──────────────────────────────────────────

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  skills        Skill[]
  experiences   Experience[]
  projects      Project[]
  educations    Education[]
  jobOffers     JobOffer[]
  resumes       Resume[]
  applications  Application[]
  aiRequests    AiRequest[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Profil ──────────────────────────────────────────────────────────────────

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  headline    String?
  summary     String?
  email       String?
  phone       String?
  location    String?
  websiteUrl  String?
  linkedinUrl String?
  githubUrl   String?
  /// Barème d'affichage des notes : 100 ou 20.
  scoreScale  Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Compétences ─────────────────────────────────────────────────────────────

enum SkillCategory {
  TECHNICAL
  TOOL
  METHODOLOGY
  SOFT
  LANGUAGE
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Skill {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    SkillCategory @default(TECHNICAL)
  level       SkillLevel?
  experiences Experience[]
  projects    Project[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, name])
}

// ─── Expériences ─────────────────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERNSHIP
  APPRENTICESHIP
  TEMPORARY
}

model Experience {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  position       String
  company        String
  location       String?
  employmentType EmploymentType?
  startDate      DateTime        @db.Date
  /// `null` signifie que le poste est en cours.
  endDate        DateTime?       @db.Date
  description    String?
  achievements   String[]
  skills         Skill[]
  projects       Project[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, startDate])
}

// ─── Projets ─────────────────────────────────────────────────────────────────

model Project {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  role          String?
  url           String?
  repositoryUrl String?
  startDate     DateTime?   @db.Date
  endDate       DateTime?   @db.Date
  experienceId  String?
  experience    Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  skills        Skill[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([experienceId])
}

// ─── Formations ──────────────────────────────────────────────────────────────

model Education {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  location     String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// ─── Offres d'emploi & analyses ──────────────────────────────────────────────

model JobOffer {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  company      String?
  location     String?
  sourceUrl    String?
  /// Texte brut de l'annonce (collé ou extrait depuis l'URL).
  description  String
  analyses     OfferAnalysis[]
  resumes      Resume[]
  applications Application[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, createdAt])
}

enum AnalysisMethod {
  /// Moteur de règles local (gratuit, déterministe).
  RULES
  /// Analyse par un modèle Claude (API Anthropic).
  AI
}

/// Résultat de la comparaison entre une offre et le parcours / CV de l'utilisateur.
model OfferAnalysis {
  id         String         @id @default(cuid())
  jobOfferId String
  jobOffer   JobOffer       @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  resumeId   String?
  resume     Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  method     AnalysisMethod
  /// Modèle utilisé pour une analyse IA.
  model      String?
  /// Note normalisée sur 100 (convertie à l'affichage selon le barème du profil).
  score      Int
  /// Détail du calcul — structure `AnalysisDetails` (src/features/analysis/types.ts).
  details    Json
  createdAt  DateTime       @default(now())

  @@index([jobOfferId, createdAt])
  @@index([resumeId])
}

// ─── CV ──────────────────────────────────────────────────────────────────────

enum ResumeKind {
  /// CV générique importé (PDF de référence).
  GENERIC
  /// CV adapté à une offre précise, généré par l'application.
  TAILORED
}

model Resume {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  kind          ResumeKind      @default(GENERIC)
  /// CV utilisé par défaut pour les analyses.
  isDefault     Boolean         @default(false)
  fileName      String?
  mimeType      String?
  fileSize      Int?
  /// Contenu du PDF importé (CV générique).
  fileData      Bytes?
  /// Texte extrait du PDF, utilisé par le moteur d'analyse.
  extractedText String?
  /// Contenu structuré d'un CV adapté — structure `TailoredResumeContent`.
  content       Json?
  /// Méthode de génération d'un CV adapté.
  method        AnalysisMethod?
  /// Mise en forme — structure `ResumeStyle` (src/features/resumes/style/types.ts).
  /// CV générique : style détecté dans le PDF. CV adapté : style choisi.
  style         Json?
  jobOfferId    String?
  jobOffer      JobOffer?       @relation(fields: [jobOfferId], references: [id], onDelete: SetNull)
  analyses      OfferAnalysis[]
  applications  Application[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, kind])
  @@index([jobOfferId])
}

// ─── Candidatures ────────────────────────────────────────────────────────────

enum ApplicationStatus {
  TO_APPLY
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    String
  position   String
  status     ApplicationStatus @default(TO_APPLY)
  appliedAt  DateTime?         @db.Date
  url        String?
  notes      String?
  jobOfferId String?
  jobOffer   JobOffer?         @relation(fields: [jobOfferId], references: [id], onDelete: SetNull)
  resumeId   String?
  resume     Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId, status])
  @@index([jobOfferId])
  @@index([resumeId])
}

// ─── Suivi de l'usage de l'IA ────────────────────────────────────────────────

enum AiRequestKind {
  ANALYSIS
  TAILORING
  /// Extraction du parcours depuis un CV PDF.
  IMPORT
}

/// Journal des appels à l'API Anthropic (quota quotidien et suivi des coûts).
model AiRequest {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         AiRequestKind
  model        String
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}
