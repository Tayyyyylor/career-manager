# Copier ce fichier en `.env` puis adapter les valeurs.

# ─── Base de données ─────────────────────────────────────────────────────────
# Chaîne de connexion PostgreSQL utilisée par Prisma (CLI et application).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/career_manager?schema=public"
# Optionnel : connexion directe utilisée par les migrations (Neon : URL sans « -pooler »).
DIRECT_URL=""

# ─── Authentification ────────────────────────────────────────────────────────
# Secret de signature des sessions (au moins 32 caractères) :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique de l'application (http://localhost:3000 en local).
BETTER_AUTH_URL="http://localhost:3000"
# Code à communiquer aux personnes autorisées à créer un compte.
# Vide = inscriptions fermées.
INVITE_CODE=""

# ─── IA (optionnel) ──────────────────────────────────────────────────────────
# Clé API Anthropic (https://console.anthropic.com). Vide = analyse par règles uniquement.
ANTHROPIC_API_KEY=""
# Modèle Claude utilisé (défaut : claude-opus-5-5).
# Alternatives moins chères : claude-sonnet-5-5, claude-haiku-5-5 (voir README).
ANTHROPIC_MODEL=""
# Optionnel : nombre maximal d'appels IA par utilisateur et par jour.
# Vide = illimité.
AI_DAILY_LIMIT=""
